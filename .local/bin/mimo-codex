#!/usr/bin/env zsh
# Launch Codex against Xiaomi MiMo. Runs in its own Codex home, so nothing
# done here (sessions, /model choices) lands in ~/.codex.
set -euo pipefail

envfile="${0:A:h}/mimo-codex.env"
[[ -r $envfile ]] || {
  print -u2 "mimo-codex: missing $envfile"
  exit 1
}
source $envfile

[[ -n ${BASE_URL:-} && -n ${MIMO_API_KEY:-} ]] || {
  print -u2 "mimo-codex: set BASE_URL and MIMO_API_KEY in $envfile"
  exit 1
}

# Xiaomi's model metadata for Codex, from
# https://example-files.cnbj1.mi-fds.com/example-files/configs/model-catalogs.json
catalog="${0:A:h:h:h}/.codex/mimo-model-catalogs.json"
[[ -r $catalog ]] || {
  print -u2 "mimo-codex: missing $catalog"
  exit 1
}

codex_home="$HOME/.codex-mimo"
mkdir -p $codex_home
[[ -e $codex_home/config.toml ]] ||
  cp "${0:A:h:h:h}/.codex/config.shared.toml" $codex_home/config.toml

# apps is off so ChatGPT connectors are not offered to MiMo as tools; the key
# is kept out of the environment of commands the model runs.
# Not mimo-v2.5-pro: its Responses stream usually finishes tool calls with an
# empty name and call_id, which Codex rejects as "unsupported call".
exec env CODEX_HOME="$codex_home" MIMO_API_KEY="$MIMO_API_KEY" codex \
  -c model_provider=mimo \
  -c model_providers.mimo.name=mimo \
  -c model_providers.mimo.base_url="\"$BASE_URL\"" \
  -c model_providers.mimo.env_key=MIMO_API_KEY \
  -c model_providers.mimo.wire_api=responses \
  -c model_catalog_json="\"$catalog\"" \
  -c model=mimo-v2.6-pro \
  -c model_reasoning_effort=high \
  -c model_reasoning_summary=none \
  -c model_context_window=1048576 \
  -c web_search=disabled \
  -c 'shell_environment_policy.exclude=["MIMO_API_KEY"]' \
  --disable apps \
  "$@"
