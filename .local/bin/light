#!/bin/sh
# Switch GTK / desktop apps to light mode.
# These dotfiles are also stowed on macOS — gsettings is Linux-only, so no-op
# there (System Settings owns appearance; appearance-watch picks it up).
[ "$(uname)" = "Linux" ] || exit 0
gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita'
appearance-sync light
echo "light mode on"
