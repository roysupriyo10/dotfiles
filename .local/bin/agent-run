#!/usr/bin/env bash
# Keep agent-only environment changes out of the interactive shell.
set -euo pipefail
[ "$#" -gt 0 ] || { echo 'usage: agent-run command [args...]' >&2; exit 1; }
label=$(basename "$1")
command_args=("$@")
if [ -n "${TMUX:-}" ] && [ -t 0 ] && [ -t 1 ]; then
  command_args=(rpaste run -- "${command_args[@]}")
fi
if command -v keep-awake >/dev/null 2>&1; then
  exec keep-awake --label "$label" -- "${command_args[@]}"
fi
exec "${command_args[@]}"
